# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# ML artifacts. The serialized model is regenerated by pwa_ml.train and is not source;
# the model CARD is kept, because it is the record of what was trained and how it scored.
ml/artifacts/*.pkl
!ml/artifacts/.gitkeep
!ml/artifacts/model_card.json

# Design review artifacts (regenerated; committed screens live in design/screens/)
design/actual/

# Playwright E2E outputs (the harness is committed; its run artifacts are not)
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.playwright/

# OS / editor
.DS_Store
*.swp

# PR-G: source-derived Rayong GIS bundle — stays local until the data owner records
# redistribution permission (docs/data/pipe-ry-provenance.md). Never commit.
data/curated/pipe_ry/

# Rehearsal / acceptance evidence archives are runtime output (SHA/hash/timing-stamped);
# the harness is committed, its run artifacts are not. Keep the .gitkeep placeholder.
evidence/*
!evidence/.gitkeep
