# Copy to repo-root .env for local runs. Never commit real secrets.
DATABASE_URL=postgresql://pwa:pwa@localhost:5433/pwa
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_ENABLED=0

# Injectable simulator fault (scored items 1.x / 2.3 / 2.4):
#   normal | anomaly | pressure_drop | bad_asset | malformed
# pressure_drop drives pressure_bar BELOW its band on pumps -> the twin's item-2.4 demo.
FAULT_MODE=normal

# The REAL curated dataset (234 branches x 39 months). Only needed when running the API
# outside compose; compose bind-mounts it and sets this itself.
CURATED_PATH=./data/curated/water_sold_by_branch.csv

# ── Rayong pipe-GIS view (PR-G) — DEFAULT OFF ───────────────────────────────────────
# The code ships dark. Enable ONLY after the data owner's redistribution permission is
# recorded in docs/data/pipe-ry-provenance.md AND `make gis-build` has produced a local
# bundle. Off: /api/twin/gis/* answers 404. On with a missing/drifted bundle: 503 —
# the API never substitutes synthetic lines for the real geometry.
PIPE_GIS_ENABLED=0
PIPE_GIS_DIR=./data/curated/pipe_ry
# Required only when enabled: canonical sidecar fingerprint from the independent
# data-approval record. Never derive approval from the generated bundle manifest.
PIPE_GIS_APPROVED_SOURCE_FINGERPRINT=
# Exact `bundle_sha256=...` printed by the trusted build and approved outside PIPE_GIS_DIR.
PIPE_GIS_APPROVED_BUNDLE_SHA256=
# PIPE_GIS_MAX_BYTES=50000000

# PR-I: the Map Ta Phut 200-customer low-pressure impact surface. Default OFF. The schema
# (migration 007) and the 200-account seed always land — they are just more SIMULATED data —
# but the enriched impact detail, the per-customer route, and the impact-zone route stay dark
# (404) until enabled. MTP_CUSTOMER_PROFILE is the versioned profile the surface serves.
MTP_CUSTOMER_IMPACT_ENABLED=0
MTP_CUSTOMER_PROFILE=mtp-low-pressure-200-v1

# Browser origins allowed to call the API cross-origin. Comma-separated, never "*".
# Mostly belt-and-braces: with the Vite proxy below the browser is same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── frontend ────────────────────────────────────────────────────────────────────────
# LEAVE VITE_API_BASE EMPTY. The app issues RELATIVE /api and /ws requests so the Vite
# dev proxy can forward them; setting an absolute base sends the twin WebSocket to Vite
# instead of FastAPI, which is why nothing could connect before PR-6. Set it only to
# bypass the proxy deliberately, e.g. serving a built dist/ from another origin.
VITE_API_BASE=

# Where the Vite dev proxy forwards /api and /ws. Compose overrides this to
# http://api:8000, which resolves only inside the compose network.
VITE_PROXY_TARGET=http://localhost:8000

# Host port overrides — set these if 1883/5433/8000/5173 are already in use locally.
# TSDB_PORT=55433
# MQTT_PORT=11883
# API_PORT=8000
# WEB_PORT=5173
